/*************************************************
 * GLOBAL CONFIGURATION
 * Applies to the whole Rofi instance
 *************************************************/
configuration {
    modi: "drun";                 // App launcher mode (apps only)
    show-icons: true;              // Show application icons
    matching: "normal";            // Strict matching (no fuzzy madness)
    drun-match-fields: "name";     // Match only app names
    font: "Pixelify Sans 11 ";        // Font + size
}
*{
    bg:rgb(17, 11, 11);
    font:rgb(255, 255, 255);
    border:rgb(33, 128, 62);
    f-color:rgb(255, 255, 255);
    accent:rgba(0, 0, 0, 0.36);
}
window {
    children:[mainbox];
    background-color:rgba(0, 0, 0, 0.63);
    background-image:url("flower.svg");
    border: 5px;
    spacing: 0px; 
    location:north;
    y-offset: 150px;
    border-color: @border;
    border-radius: 0px;            // Rounded corners
    padding: 10px;
    width: 30%;
}
mainbox {
    children:[inputbar,listview];
    orientation:vertical;
    spacing: 10px;                  // Space between elements
    background-color: transparent;
}
inputbar {
    children: [entry ];    // Left: prompt | Right: text field
    background-color:transparent;
}

/*************************************************
 * ENTRY (where you type)
 *************************************************/
entry {
    background-color: @accent;
    placeholder:"Search...";
    border: 0px;
    border-color:@border;
    border-radius:0px;
    text-color: rgb(255, 255, 255) ;
    padding: 10px;
}

/*************************************************
 * LISTVIEW
 * Container for the app results
 *************************************************/
listview {
    background-color: #00000000;
    lines: 7;        /* rows */                  // Number of visible results
    spacing: 0px;
    padding:0px;
    border-radius:0px;
    scrollbar: false;
}

/*************************************************
 * ELEMENT
 * One result row (app)
 *************************************************/
element {
    background-color: transparent;
    orientation:horizontal;
    /*border: 0px 0px 1px 0px;*/
    border-color: #000000;
    padding: 10px;    /**border-radius: 10px;**/
}

/*************************************************
 * ELEMENT (selected / highlighted)
 *************************************************/
element selected {
    background-color: @accent;
    border-radius:0px;
    border-color:rgb(33, 128, 62);
    border: 0px 0px 5px;
}
/*************************************************
 * ELEMENT TEXT
 * App name text
 *************************************************/
element-text {
    text-color:@f-color;
    size:10px;
    horizontal-align:0;
    vertical-align:0.5;
    background-color: #00000000;
}


/*************************************************
 * ELEMENT ICON
 * App icon settings
 *************************************************/
element-icon {
    size: 20px;
    margin: 0 10px 0 0;
    background-color: #00000000;
}

/*************************************************
 * MESSAGE (rarely used)
 * Shown when no results are found
 *************************************************/
message {
    background-color: @bg;
    padding:20px;
}

/*************************************************
 * MESSAGE TEXT
 *************************************************/
textbox {
    text-color: #000000;
}