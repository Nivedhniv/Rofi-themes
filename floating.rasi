/*************************************************
 * GLOBAL CONFIGURATION
 * Applies to the whole Rofi instance
 *************************************************/
configuration {
    modi: "drun";                 // App launcher mode (apps only)
    show-icons: true;              // Show application icons
    matching: "normal";            // Strict matching (no fuzzy madness)
    drun-match-fields: "name";     // Match only app names
    font: "Inconsolata Bold 12";        // Font + size
}


/*************************************************
 * GLOBAL VARIABLES
 * Think of these like simple constants
 *************************************************/
* {
    bg:        #00000013;             // Main background
    fg:        #ff9900c2;             // Main text color
    accent:    #3d3d3dff;             // Highlight / accent color     
    border:    #858585ff;             // Border color
    selected:  #858585af;             // Selected item background
    f-color: #ffffffff;
    trans: #00000000;
}

/*************************************************
 * WINDOW
 * The outer container (the big box)
 *************************************************/
window {
    background-color: transparent;
    
    border-radius: 5px;            // Rounded corners
    padding: 12px;
    width: 30%;
}

/*************************************************
 * MAIN BOX
 * Holds input + listview
 *************************************************/
mainbox {
    spacing: 10px;                  // Space between elements
    background-color: transparent;
}

/*************************************************
 * INPUT BAR (search box)
 *************************************************/
inputbar {
    children: [ prompt, entry ];    // Left: prompt | Right: text field
    background-color:@trans;
}

/*************************************************
 * PROMPT (usually the ">" symbol)
 *************************************************/
prompt {
    /*text: "Apps";
    text-color: @accent;
    padding: 8px;
    background-color: #727272ff;*/
     enabled: false;
}

/*************************************************
 * ENTRY (where you type)
 *************************************************/
entry {
    background-color: @accent;
    placeholder:"Search...";
    border: 2px;
    border-color:@border;
    border-radius:100px;
    text-color: #f0f0f0ff ;
    padding: 10px 20px 10px 20px;
}

/*************************************************
 * LISTVIEW
 * Container for the app results
 *************************************************/
listview {
    background-color: @accent;
    padding:10px;
    border-radius:10px;
    border: 2px;
    border-color:@border;
    lines: 6;        /* rows */
    /* columns: 3;      number of columns */                   // Number of visible results
    spacing: 0px;
    scrollbar: false;
}

/*************************************************
 * ELEMENT
 * One result row (app)
 *************************************************/
element {
    background-color: transparent;
    /*border: 0px 0px 1px 0px;*/
    border-color: #000000;
    padding: 10px;    /**border-radius: 10px;**/
}

/*************************************************
 * ELEMENT (selected / highlighted)
 *************************************************/
element selected {
    background-color: @selected;
    border-radius:5px;
    border: 2px;
    border-color:@border;
}
/*************************************************
 * ELEMENT TEXT
 * App name text
 *************************************************/
element-text {
    text-color:@f-color;
    background-color: #00000000;
}

/*************************************************
 * ELEMENT ICON
 * App icon settings
 *************************************************/
element-icon {
    size: 22px;
    margin: 0 10px 0 0;
    background-color: #00000000;
}

/*************************************************
 * MESSAGE (rarely used)
 * Shown when no results are found
 *************************************************/
message {
    background-color: transparent;
}

/*************************************************
 * MESSAGE TEXT
 *************************************************/
textbox {
    text-color: @fg;
}
